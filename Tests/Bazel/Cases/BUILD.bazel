load("@swift-bylaws//bazel:defs.bzl", "bylaws_lint")
load(":generate.bzl", "generated_directory", "overlapping_directory")

overlapping_directory(name = "generated")

bylaws_lint(
    name = "overlap",
    srcs = [
        "Sources/Model.swift",
        ":generated",
    ],
)

genrule(
    name = "generated_file",
    srcs = ["Inputs/Generated.swift"],
    outs = ["Sources/Generated.swift"],
    cmd = "cp $(location Inputs/Generated.swift) $@",
)

generated_directory(
    name = "generated_tree",
    src = "Inputs/GeneratedTree.swift",
)

genrule(
    name = "legacy_source",
    srcs = ["Inputs/Legacy.txt"],
    outs = ["Sources/Legacy.swift"],
    cmd = "cp $(location Inputs/Legacy.txt) $@",
)

filegroup(
    name = "checked_sources",
    srcs = [
        "Sources/Model.swift",
        "Sources/Other folder/Model.swift",
    ],
)

bylaws_lint(
    name = "cache",
    srcs = [
        ":checked_sources",
        ":generated_file",
        ":generated_tree",
    ],
    data = [
        "Inputs/Data.txt",
        "//:MODULE.bazel",
    ],
    rules = ["Rules/Final.swift"],
)

bylaws_lint(
    name = "selection_cache_size",
    srcs = ["Sources/Model.swift"],
    data = ["//:MODULE.bazel"],
    rules = ["Rules/Final.swift"],
    selection_cache_size = "32MiB",
)

bylaws_lint(
    name = "selection_cache_disabled",
    srcs = ["Sources/Model.swift"],
    data = ["//:MODULE.bazel"],
    rules = ["Rules/Final.swift"],
    selection_cache_size = "0",
)

bylaws_lint(
    name = "selection_cache_invalid",
    srcs = ["Sources/Model.swift"],
    data = ["//:MODULE.bazel"],
    rules = ["Rules/Final.swift"],
    selection_cache_size = "32MiBB",
)

bylaws_lint(
    name = "advisory",
    srcs = ["Sources/Violation.swift"],
    data = ["//:MODULE.bazel"],
    rules = ["Rules/Advisory.swift"],
)

bylaws_lint(
    name = "strict",
    srcs = ["Sources/Violation.swift"],
    data = ["//:MODULE.bazel"],
    rules = ["Rules/Advisory.swift"],
    strict = True,
)

bylaws_lint(
    name = "baseline",
    srcs = ["Sources/Violation.swift"],
    baseline = "Baseline.swift",
    data = ["//:MODULE.bazel"],
    rules = ["Rules/Final.swift"],
)

bylaws_lint(
    name = "stale_baseline",
    srcs = ["Sources/Model.swift"],
    baseline = "Baseline.swift",
    data = ["//:MODULE.bazel"],
    rules = ["Rules/Final.swift"],
)

bylaws_lint(
    name = "discovery",
    srcs = ["Sources/Model.swift"],
    data = [
        "//:Bylaws.swift",
        "//:MODULE.bazel",
    ],
)

bylaws_lint(
    name = "discovery_from_srcs",
    srcs = [
        "Sources/Model.swift",
        "//:Bylaws.swift",
    ],
    data = ["//:MODULE.bazel"],
)

bylaws_lint(
    name = "index",
    srcs = ["Sources/Model.swift"],
    data = ["//:MODULE.bazel"],
    rules = ["Rules/Index.swift"],
)

bylaws_lint(
    name = "language_mode_5",
    srcs = [":legacy_source"],
    data = ["//:MODULE.bazel"],
    rules = ["Rules/Final.swift"],
    swift_language_mode = "5",
)

bylaws_lint(
    name = "language_mode_6",
    srcs = [":legacy_source"],
    data = ["//:MODULE.bazel"],
    rules = ["Rules/Final.swift"],
    swift_language_mode = "6",
)

bylaws_lint(
    name = "empty_sources",
    data = ["//:MODULE.bazel"],
    rules = ["Rules/Final.swift"],
)

bylaws_lint(
    name = "direct_files",
    srcs = [
        "Sources/Model.swift",
        "Sources/Other folder/Model.swift",
    ],
    data = ["//:MODULE.bazel"],
    rules = ["Rules/Final.swift"],
)

bylaws_lint(
    name = "parse_action_size",
    srcs = [
        "Sources/Model.swift",
        "Sources/Other folder/Model.swift",
    ],
    data = ["//:MODULE.bazel"],
    rules = ["Rules/Final.swift"],
    sources_per_parse_action = 1,
)

bylaws_lint(
    name = "invalid_parse_action_size",
    srcs = ["Sources/Model.swift"],
    data = ["//:MODULE.bazel"],
    rules = ["Rules/Final.swift"],
    sources_per_parse_action = 0,
)
